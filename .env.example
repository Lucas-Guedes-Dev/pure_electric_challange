# Copie para .env para sobrescrever os padrões do docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pure_eletric
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUG=false
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# Sessão: desloga após N minutos sem requisições / tempo máximo de vida
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
# true em produção (HTTPS)
SESSION_COOKIE_SECURE=false

# Logs (console + Elasticsearch/Kibana)
LOG_LEVEL=INFO
ENVIRONMENT=development
# Deixe vazio (ELASTICSEARCH_URL=) para não enviar logs ao Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_VERSION=9.5.3
# Memória do Elasticsearch (heap da JVM e limite do container)
ELASTIC_HEAP=512m
ELASTIC_MEM_LIMIT=1g
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Pedidos: chave do webhook (header X-Webhook-Key) e comportamento do worker
ORDERS_WEBHOOK_KEY=dev-webhook-key
ORDER_MAX_ATTEMPTS=3
ORDER_RETRY_BASE_SECONDS=5
INTERNAL_SYSTEM_TIMEOUT_SECONDS=5
# Fração das chamadas ao sistema interno (mock) que falham ao acaso (0 a 1)
INTERNAL_SYSTEM_FAILURE_RATE=0.2
# Simulador de pedidos na interface (desligue fora de desenvolvimento)
ORDER_SIMULATOR_ENABLED=true
