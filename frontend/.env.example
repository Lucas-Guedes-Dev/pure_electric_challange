# URL base usada pelo httpClient. "/api" usa o proxy do Vite (recomendado).
VITE_API_URL=/api
# Para onde o proxy do Vite encaminha /api (no Docker é http://backend:8000)
VITE_PROXY_TARGET=http://localhost:8000
# Login exigido nas rotas privadas (padrão). "false" libera tudo sem login, só para desenvolver telas.
VITE_AUTH_ENABLED=true
