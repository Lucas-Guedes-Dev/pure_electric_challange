# Usado ao rodar o backend fora do Docker (copie para .env)
DEBUG=true
DOCS_ENABLED=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pure_eletric
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
SESSION_WARNING_SECONDS=120
SESSION_COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
LOG_LEVEL=INFO
ENVIRONMENT=development
# Com o Elasticsearch do docker compose rodando: http://localhost:9200. Vazio = só console
ELASTICSEARCH_URL=
ORDERS_WEBHOOK_KEY=dev-webhook-key
INTERNAL_SYSTEM_URL=http://localhost:9000
INTERNAL_SYSTEM_TIMEOUT_SECONDS=5
ORDER_MAX_ATTEMPTS=3
ORDER_RETRY_BASE_SECONDS=5
ORDER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=10
ORDER_EVENTS_LISTENER_ENABLED=true
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_TOKENS=2000
ORDER_SIMULATOR_ENABLED=true
